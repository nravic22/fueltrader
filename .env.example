# Supabase (Settings → API in your project dashboard)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — only used by scripts/ingest.mjs, never the app itself.
# Do not put this in a deployed environment's env vars.
SUPABASE_SERVICE_ROLE_KEY=

# Pick ONE provider for query parsing/answer generation, and set LLM_PROVIDER
# to match. Only the matching key needs a real value.
LLM_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Note: OPENAI_API_KEY above is required for semantic brand-name matching
# (lib/semanticSearch.ts) regardless of which LLM_PROVIDER you chose, since
# embeddings always go through OpenAI's API. Leave it blank to disable
# semantic matching — the app falls back to plain substring matching
# automatically, no errors.

# Chroma connection — omit all three to use a local server instead
# (`npx chroma run`, defaults to localhost:8000). Set these to use Chroma
# Cloud (needed for serverless deploys like Vercel, which can't run a local
# Chroma server process).
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Rate limiting on /api/query (lib/rateLimit.ts) — a burst limit (10/min) and
# a daily cap (100/day) per IP, to bound worst-case LLM/embedding token spend
# from one actor. Free tier at upstash.com/redis. Leave blank to disable (no
# rate limiting at all) — fine for local dev, NOT recommended in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site-wide HTTP Basic Auth (middleware.ts) — gates every page and API route
# behind a single shared username/password, checked before anything else
# runs. Leave both blank to disable (no auth at all) — fine for local dev,
# NOT recommended in production.
SITE_BASIC_AUTH_USER=
SITE_BASIC_AUTH_PASSWORD=
